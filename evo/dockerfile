FROM node:20-alpine AS client-build
WORKDIR /app
COPY client/package*.json ./
RUN npm ci
COPY client/ .
RUN npm run build

FROM rust:1-alpine AS server-build
RUN apk add --no-cache musl-dev
WORKDIR /app
COPY server/ .
RUN cargo build --release

FROM alpine:3.20
WORKDIR /srv
COPY --from=server-build /app/target/release/evo-server /evo-server
COPY --from=client-build /app/dist ./public

EXPOSE 80
ENTRYPOINT ["/evo-server"]
